# ==============================================================================
# RAFIKI WASTEOS — ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================
# This project uses TWO completely separate Neon PostgreSQL databases (no Neon branching):
#   1. Production Database:  rafikiWasteOS     (Project ID: restless-flower-97330650) -> Git `main` branch / Vercel Production
#   2. Development Database: rafikiWasteOS_dev (Project ID: weathered-glade-32717093) -> Git `development` branch / Local & Vercel Preview
#
# Copy this file to `.env.local` for local development on the `development` branch.
# ==============================================================================

# Pooled connection string (used by Next.js application at runtime)
DATABASE_URL="postgresql://neondb_owner:<password>@<endpoint>-pooler.<region>.aws.neon.tech/neondb?channel_binding=require&sslmode=require"

# Direct / unpooled connection string (used by Drizzle Kit for schema migrations)
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:<password>@<endpoint>.<region>.aws.neon.tech/neondb?channel_binding=require&sslmode=require"

# Neon Auth (Managed Better Auth) endpoints for the corresponding database project
NEON_AUTH_BASE_URL="https://<endpoint>.neonauth.<region>.aws.neon.tech/neondb/auth"
NEON_AUTH_JWKS_URL="https://<endpoint>.neonauth.<region>.aws.neon.tech/neondb/auth/.well-known/jwks.json"
NEON_AUTH_COOKIE_SECRET="rafiki_wasteos_auth_cookie_secret_key_938472910482_emerging_market"

# Admin onboarding invite key
ADMIN_INVITE_KEY="RAFIKI-ADMIN-2026"
